# Backend API used by the server functions (Laravel base URL, including the
# version segment — the app calls /admin/* paths on top of it).
BACKEND_API_URL=http://localhost:8000/api/v1

# iron-session secret — must be at least 32 characters.
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-chars

# Public URL this admin is served from (used for redirects and cookies).
VITE_APP_URL=http://localhost:3000

# Optional
VITE_ENV=local
VITE_ROOT_DOMAIN=localhost
# VITE_API_BROADCASTING_URL=https://api.example.com/api
# VITE_REVERB_APP_KEY=
# VITE_REVERB_HOST=
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=http
